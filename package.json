{
  "name": "robotron",
  "version": "3.1.0",
  "description": "A web-based remake of the classic arcade game Robotron 2084",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "./deploy.sh",
    "test": "npm run test:prng",
    "test:prng": "node --experimental-strip-types --no-warnings tests/prng-golden.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shatch/robotron.git"
  },
  "keywords": [],
