  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/shatch/robotron/issues"
  },
  "homepage": "https://github.com/shatch/robotron#readme",
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^24.0.10",
    "@types/pixi.js": "^4.8.9",
    "terser": "^5.49.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "pixi.js": "^8.11.0"
  }
